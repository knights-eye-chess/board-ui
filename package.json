{
  "name": "@knights-eye-chess/board-ui",
  "version": "0.1.0-dev.32",
  "private": true,
  "type": "module",
  "description": "Controlled engine-free chess board UI with host-owned position and legality",
  "exports": {
    ".": {
      "types": "./dist/controlled-board.d.ts",
      "import": "./dist/controlled-board.js"
    },
    "./pieces/*": "./assets/pieces/*",
    "./renderer": {
      "types": "./dist/controlled-board-renderer.d.ts",
      "import": "./dist/controlled-board-renderer.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
    },
    "./arrows": {
      "types": "./dist/arrows.d.ts",
      "import": "./dist/arrows.js"
    },
    "./move-strip": {
      "types": "./dist/move-strip.d.ts",
      "import": "./dist/move-strip.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./icons/*": "./assets/icons/*",
    "./move-strip-panel": {
      "types": "./dist/move-strip-panel.d.ts",
      "import": "./dist/move-strip-panel.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tests",
    "build.mjs",
    "README.md",
    "assets",
    "docs",
    "SOURCE-ORIGIN.json",
    "scripts",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE-ARTWORK",
    "NPM-PUBLISHING.md",
    "npm-release.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "docs:screenshot": "node examples/capture-screenshot.mjs",
    "check": "npm run build && npm test",
    "pack:checked": "npm run check && node scripts/pack.mjs",
    "pack:artifact": "node scripts/pack.mjs",
    "demo:build": "npm run build && node examples/demos/build.mjs",
    "demo:serve": "npm run demo:build && node examples/demos/serve.mjs",
    "demo:test": "node --test examples/demos/tests/*.test.mjs",
    "demo:check": "npm run demo:build && npm run demo:test && node examples/demos/tests/browser.mjs",
    "publish:verify": "node scripts/verify-release.mjs",
    "publish:prepare": "npm run pack:checked && npm run publish:verify"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "playwright": "1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knights-eye-chess/board-ui.git"
  },
  "license": "MIT"
}
